# Client ID from your own Spotify Developer app (https://developer.spotify.com/dashboard).
# Register these Redirect URIs on the app: http://127.0.0.1/ and http://127.0.0.1:5173/
VITE_SPOTIFY_CLIENT_ID=

# Optional: bootstrap refresh token so the device never needs to show the login screen.
# Get one by running `bun dev`, opening http://127.0.0.1:5173, logging in there (where you
# have a real keyboard), then in DevTools console: localStorage.getItem('spotifyRefreshToken')
VITE_SPOTIFY_REFRESH_TOKEN=
